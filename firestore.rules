rules_version = '2';

// Combined rules for mobile app + admin webapp.
// Source of truth for admin status: users/{uid}.role == 'admin'
// (No separate admins/ collection — we removed the webapp's parallel gate.)

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── Users ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:           if isOwner(userId) || isAdmin();
      allow create:         if isOwner(userId) || isAdmin();
      allow update, delete: if isOwner(userId) || isAdmin();

      match /{subcollection=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // ── Providers ─────────────────────────────────────────────────────────
    match /providers/{providerId} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }

    // ── Appointments ──────────────────────────────────────────────────────
    match /appointments/{appointmentId} {
      allow read:  if signedIn();
      allow write: if signedIn();
    }

    // ── Content collections (published-or-admin read, admin-only write) ───
    match /products/{productId} {
      allow read:  if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    match /videos/{videoId} {
      allow read:  if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    match /blogs/{blogId} {
      allow read:  if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    match /podcasts/{podcastId} {
      allow read:  if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read:  if resource.data.visible == true || isAdmin();
      allow write: if isAdmin();
    }

    match /learningMaterials/{materialId} {
      allow read:  if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    match /activeExercises/{exerciseId} {
      allow read:  if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    // ── Orders ────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.customerId is string
        && request.resource.data.customerId == request.auth.uid;
      allow read:   if isAdmin()
        || (signedIn()
            && resource.data.customerId is string
            && resource.data.customerId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ── Broadcasts (admin webapp → audit log of admin push notifications) ─
    // Writes happen server-side through the sendAdminNotification Cloud
    // Function (uses admin SDK → bypasses rules). Clients never write here.
    match /broadcasts/{broadcastId} {
      allow read:  if isAdmin();
      allow write: if false;
    }
  }
}
